generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password_hash String
  nama         String
  role         String   @default("admin")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("users")
}

model MarkasPMI {
  id                     Int      @id @default(autoincrement())
  nama_pmi               String
  level_pmi              String
  nama_kepala_markas     String
  no_telpon              String
  email                  String
  kode_pos               String
  alamat                 String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@map("markas_pmi")
}

model UnitPMR {
  id           Int      @id @default(autoincrement())
  kode_unit    String?  @unique
  nama_unit    String
  alamat       String?
  email        String?
  no_telpon    String?
  status       String   @default("Aktif")
  tingkat      String
  provinsi     String?
  kabupaten    String?
  sk           String?
  lat          Float?
  lng          Float?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("unit_pmr")
}

model UnitKSR {
  id           Int      @id @default(autoincrement())
  kode_unit    String?  @unique
  nama_unit    String
  alamat       String?
  email        String?
  no_telpon    String?
  status       String   @default("Aktif")
  jenis        String
  kategori     String?
  provinsi     String?
  kabupaten    String?
  catatan      String?
  sk           String?
  lat          Float?
  lng          Float?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("unit_ksr")
}

model UnitTSR {
  id           Int      @id @default(autoincrement())
  kode_unit    String?  @unique
  nama_unit    String
  alamat       String?
  email        String?
  no_telpon    String?
  status       String   @default("Aktif")
  jenis        String
  provinsi     String?
  kabupaten    String?
  sk           String?
  lat          Float?
  lng          Float?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("unit_tsr")
}

